# ============================================================
# BloxBuilt Website — Environment Variables
# ============================================================
# Set these in your Vercel Project → Settings → Environment Variables.
# Locally, copy this file to `.env.local` and fill it in.

# --- Admin access ---------------------------------------------------------
# The secret path segment for the admin panel. Visiting
#   https://bloxbuilt.xyz/admin/<ADMIN_SECRET>
# opens the panel. Make it long and unguessable.
ADMIN_SECRET=change-me-to-a-long-random-string

# A second secret used to authorize the save/delete API calls. The admin page
# uses this automatically; it stops anyone who finds the URL from editing data.
ADMIN_API_KEY=change-me-to-another-long-random-string

# Public Discord invite shown on the site (optional).
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite

# Public site URL, used in the Discord post link (optional).
NEXT_PUBLIC_SITE_URL=https://bloxbuilt.xyz

# --- Post new builds to a Discord channel (optional) ---------------------
# When both are set, adding a build in the admin panel posts an embed to this
# channel via the bot. Use the SAME bot token as your Discord bot (or any bot
# in the server that can see the channel), and the target channel's ID.
DISCORD_BOT_TOKEN=
DISCORD_BUILDS_CHANNEL_ID=

# --- Vercel KV (build storage) -------------------------------------------
# Created automatically when you add a KV/Upstash store to the project in the
# Vercel dashboard (Storage tab). Vercel injects these for you — you normally
# do NOT paste them by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob (image uploads) -----------------------------------------
# Created automatically when you add a Blob store to the project. Vercel
# injects this too.
BLOB_READ_WRITE_TOKEN=
